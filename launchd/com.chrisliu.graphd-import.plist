<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly transcript backfill. Reads local files and writes SQLite; spends no model tokens, so
     it is safe to run unattended. Hourly rather than weekly so `graph stats` answers about today,
     and so the Monday harvest interprets data at most an hour old. The harvest that *interprets*
     this data stays scheduled separately. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chrisliu.graphd-import</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/chrisliu/.nvm/versions/node/v22.22.3/bin/node</string>
    <string>/Users/chrisliu/romp/graph-mechanism/bin/graph-import.mjs</string>
    <string>8</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/chrisliu/.graphd/logs/graphd-import.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/chrisliu/.graphd/logs/graphd-import.err</string>
</dict>
</plist>
